FoamFile
{
    format      binary;
    class       volVectorField;
    location    "0";
    object      vorticity;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform (0 -0 0);

boundaryField
{
    inletGeo
    {
        type            calculated;
        value           uniform (0 -0 0);
    }
    outletGeo
    {
        type            calculated;
        value           uniform (0 -0 0);
    }
    wallsGeo
    {
        type            calculated;
        value           uniform (0 -0 0);
    }
    mitralABodyGeo
    {
        type            calculated;
        value           uniform (0 -0 0);
    }
    mitralBBodyGeo
    {
        type            calculated;
        value           uniform (0 -0 0);
    }
    mitralRingWallGeo
    {
        type            calculated;
        value           uniform (0 -0 0);
    }
}


