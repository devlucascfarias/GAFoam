FoamFile
{
    format      ascii;
    class       dictionary;
    object      extrudeMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

constructFrom patch;

sourceCase ".";
sourcePatches (back);

exposedPatchName front;

flipNormals false;

extrudeModel        linearNormal;

nLayers             1;

linearNormalCoeffs
{
    thickness       0.001;
}

mergeFaces false;  

// Merge small edges. Fraction of bounding box.
//mergeTol 0;
