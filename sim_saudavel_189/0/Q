FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      Q;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inletGeo
    {
        type            calculated;
        value           uniform 0;
    }
    outletGeo
    {
        type            calculated;
        value           uniform 0;
    }
    wallsGeo
    {
        type            calculated;
        value           uniform 0;
    }
    front_and_backGeo
    {
        type            symmetry;
    }

    "(minX|maxX|minY|maxY|minZ|maxZ)"
    {
        type            symmetry;
    }
}


