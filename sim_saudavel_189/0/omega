FoamFile
{
    format      ascii;
    class       volScalarField;
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 100; // Valor inicial estimado

boundaryField
{
    inletGeo
    {
        // Frequência de turbulência na entrada
        type            fixedValue;
        value           uniform 50; 
    }

    outletGeo
    {
        type            zeroGradient;
    }

    wallsGeo
    {
        // Condição de parede essencial para o modelo kOmegaSST
        type            omegaWallFunction;
        value           uniform 50;
    }

    // --- CRUCIAL PARA 2D ---
    front_and_backGeo
    {
        type            symmetry;
    }

    "(minX|maxX|minY|maxY|minZ|maxZ)"
    {
        type            symmetry;
    }

}

