FoamFile
{
    format      ascii;
    class       dictionary;
    location    "constant";
    object      momentumTransport;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

simulationType  laminar;

RAS

{
    // Liga a turbulência
    turbulence      on;

    model           kOmegaSST;

    printCoeffs     on;
}
