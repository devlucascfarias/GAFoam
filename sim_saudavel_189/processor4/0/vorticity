FoamFile
{
    format      binary;
    class       volVectorField;
    location    "0";
    object      vorticity;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    minX
    {
        type            symmetry;
    }
    maxX
    {
        type            symmetry;
    }
    minY
    {
        type            symmetry;
    }
    maxY
    {
        type            symmetry;
    }
    minZ
    {
        type            symmetry;
    }
    maxZ
    {
        type            symmetry;
    }
    inletGeo
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    outletGeo
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    wallsGeo
    {
        type            calculated;
        value           uniform (0 0 0);
    }
    front_and_backGeo
    {
        type            symmetry;
    }
    procBoundary4to3
    {
        type            processor;
        value           uniform (0 0 0);
    }
    procBoundary4to5
    {
        type            processor;
        value           uniform (0 0 0);
    }
}


