FoamFile
{
    format      binary;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform 100;

boundaryField
{
    minX
    {
        type            symmetry;
    }
    maxX
    {
        type            symmetry;
    }
    minY
    {
        type            symmetry;
    }
    maxY
    {
        type            symmetry;
    }
    minZ
    {
        type            symmetry;
    }
    maxZ
    {
        type            symmetry;
    }
    inletGeo
    {
        type            fixedValue;
        value           nonuniform List<scalar> 
0
;
    }
    outletGeo
    {
        type            zeroGradient;
    }
    wallsGeo
    {
        type            omegaWallFunction;
        value           uniform 50;
    }
    front_and_backGeo
    {
        type            symmetry;
    }
    procBoundary6to1
    {
        type            processor;
        value           uniform 100;
    }
    procBoundary6to2
    {
        type            processor;
        value           uniform 100;
    }
    procBoundary6to7
    {
        type            processor;
        value           uniform 100;
    }
}


